# =============================================================================
# Application
# =============================================================================
APP_NAME=Ansly LLM
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Browser origins allowed to call the API (the extension's background worker
# is not subject to CORS). Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Supabase (Dashboard -> Project Settings -> API Keys)
# The API reads profiles with each user's own token, so only the publishable
# key is needed. Never put the secret / service-role key here.
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Only for projects that still sign JWTs with the legacy HS256 secret.
SUPABASE_JWT_SECRET=

# =============================================================================
# Answer generation and usage limits
# =============================================================================
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
JOB_DESCRIPTION_MAX_CHARS=6000
RATE_LIMIT_PER_MINUTE=10
DAILY_GENERATION_LIMIT=100
# Resume tailoring (v1.2) has its own daily limit; confirm the value before release.
DAILY_TAILORING_LIMIT=10
# Run tailorings in the background after they start. Defaults to off on Vercel (which freezes background work),
# where status polls run the steps instead.
# TAILORING_BACKGROUND=true

# =============================================================================
# Cost accounting and model routing (per-call rows in public.llm_calls)
# =============================================================================
# Prices for models core/pricing.py doesn't list (it lists Claude models). Without a price a call's cost is
# recorded as null ("unpriced"), never guessed. USD per million tokens:
# MODEL_PRICING_JSON={"gemini-2.5-flash-lite": {"input": 0.10, "output": 0.40, "cache_read": 0.025}}
# Write usage rows after the response is sent. Defaults to off on Vercel (rows written before responding).
# USAGE_WRITE_BACKGROUND=true
# Also route simple answers (one technology the profile shows, a degree) to ANTHROPIC_FAST_MODEL. Leave off
# until the fast model passes scripts/eval_answers.py for your traffic.
# FAST_MODEL_SIMPLE_ANSWERS=false

# =============================================================================
# LLM gateway: ordered fallback across providers and keys
# =============================================================================
# Providers are tried in this order; each key is its own deployment, then the
# provider's *_FALLBACK_MODEL (if set) on its first key.
GATEWAY_PROVIDER_ORDER=gemini,groq,openai,anthropic,mistral,cerebras,cohere,openrouter
GATEWAY_DISABLED_PROVIDERS=
# Attempts per request across all deployments. Raise it if you have many keys
# and want every provider to get a turn.
GATEWAY_MAX_ATTEMPTS=10
GATEWAY_COOLDOWN_SECONDS=60
GATEWAY_TIMEOUT_SECONDS=30
GATEWAY_RETRIES=0

# Keys: <PREFIX> and/or <PREFIX>1, <PREFIX>2, ... (up to 20 per provider).
# Leave unused providers blank.

# Google Gemini
GOOGLE_API_KEY1=
GOOGLE_API_KEY2=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY1=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# OpenAI
OPENAI_API_KEY1=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=

# Anthropic (called through the official anthropic SDK)
ANTHROPIC_API_KEY1=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACK_MODEL=
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_EFFORT=medium
# Cheaper model for fast-tier stages (job analysis, review, saved-answer adaptation): see token_budget.STAGE_TIER.
# Haiku 4.5 doesn't take effort; it's sent without it.
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Semantic retrieval fallback (off when empty): "gemini" or "openai", using that provider's first key above.
# EMBEDDING_PROVIDER=

# Mistral
MISTRAL_API_KEY1=
MISTRAL_MODEL=mistral-small-latest

# Cerebras
CEREBRAS_API_KEY1=
CEREBRAS_MODEL=qwen-3.8-27b

# Cohere
COHERE_API_KEY1=
COHERE_MODEL=command-a-03-2025

# OpenRouter
OPENROUTER_API_KEY1=
OPENROUTER_MODEL=openrouter/auto
